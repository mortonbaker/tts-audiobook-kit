# publish/publish.sh book.env  -- one file per book
BOOK="A Sample Book"
AUTHOR="The Author"
YEAR=2015
NARRATOR="Narrator (voice clone)"
PARTS=examples/parts.tsv                  # NN<TAB>Title, one line per part wav
WAV_DIR=out                               # or user@render-box:book/out
DEST="/audiobooks/The Author/A Sample Book"   # or user@abs-host:/path, inside an ABS library folder
COVER=cover.jpg
DESC=desc.txt

# AudiobookShelf (leave ABS_URL empty to just drop the mp3s in DEST)
ABS_URL=http://127.0.0.1:13378
ABS_LIBRARY=Narrated
ABS_FOLDER=/audiobooks                    # library root as the ABS server sees it
# ABS_TOKEN=...   or ABS_USER/ABS_PASSWORD, or ABS_CREDS=~/abs-creds.txt

# NTFY_TOPIC=your-topic                   # optional phone pushes via ntfy.sh
